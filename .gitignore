# OS / editor junk
.DS_Store
Thumbs.db

# api.php atomic-write temp files (temp + rename); should never be committed
*.tmp-*

# Local-only notes / scratch that don't belong in the release
*.local.md

# ---- Deploy target (.gitignore, applied when a deploy dir is git-linked to
# ---- this repo) ----------------------------------------------------------
# Live board data is OWNED by each deploy directory and must never be pulled
# from the repo (a `git pull` must not overwrite running kids'/adults' data).
boards/*.json
boards.json
tasks.json
